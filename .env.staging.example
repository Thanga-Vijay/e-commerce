# Staging Environment Variables
# Copy this file to .env.staging and update with your values

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_password_change_me

# Redis
REDIS_PASSWORD=staging_redis_password

# JWT Secret
JWT_SECRET=staging_jwt_secret_key_change_me

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret

# SMTP
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_mailtrap_username
SMTP_PASSWORD=your_mailtrap_password
SMTP_FROM=noreply@staging.yourdomain.com
SMTP_FROM_NAME=E-Commerce Platform (Staging)
